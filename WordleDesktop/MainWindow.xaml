<Window x:Class="WorldDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WorldDesktop"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="600">
    <Grid Background="#343761">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="WORDLE" Foreground="White" FontSize="48" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                <UniformGrid x:Name="GameGrid" Rows="6" Columns="5" Width="300" Height="360" Margin="0,0,0,20">
                        <Border BorderBrush="#3A3A3C" BorderThickness="2" Margin="3">
                        <TextBlock Text="" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                </UniformGrid>

                <TextBox x:Name="InputBox" 
                Opacity="0" 
                Height="0"
                MaxLength="5" 
                TextChanged="InputBox_TextChanged"
                KeyDown="InputBox_KeyDown"/>
                <Button x:Name="CheckButton" Content="CHECK WORD" Width="150" Height="40" Click="CheckButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
